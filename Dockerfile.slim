COPY --chmod=0755 browser-use-local /usr/local/bin/browser-use
COPY --chmod=0755 refresh-browser-use-skills /opt/codex/refresh-browser-use-skills

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_TOOL_DIR=/opt/browser-use/tools \
