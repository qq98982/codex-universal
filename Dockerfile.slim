### PYTHON CLI HELPERS ###

ARG UV_VERSION=0.12.23
ARG FFSUBSYNC_VERSION=0.5.1

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/pipx \
    python3 -m pip install --break-system-packages --no-cache-dir --no-compile "uv==${UV_VERSION}" \
    && pipx install --pip-args="--no-cache-dir --no-compile --root-user-action=ignore" "ffsubsync==${FFSUBSYNC_VERSION}" \
    && uv --version \
    && ffsubsync --version

### NODE ###

ARG NODE_VERSION=24.21.0
ARG NODE_SHA256_AMD64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
ARG NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
ARG NPM_VERSION=12.2.0

RUN --mount=type=cache,target=/root/.npm \
    set -e; \
    case "$TARGETARCH" in \
      amd64) node_arch="x64"; node_sha256="$NODE_SHA256_AMD64" ;; \
      arm64) node_arch="arm64"; node_sha256="$NODE_SHA256_ARM64" ;; \
      *) echo "Unsupported Node.js architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    node_asset="node-v${NODE_VERSION}-linux-${node_arch}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${node_asset}.tar.xz" -o /tmp/node.tar.xz; \
    echo "${node_sha256}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    npm install -g "npm@${NPM_VERSION}"; \
    npm cache clean --force || true; \
    node --version; \
    npm --version

### HEADLESS BROWSERS ###

ARG PLAYWRIGHT_VERSION=1.63.0

COPY playwright-browser fetch-page /usr/local/bin/

RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -e; \
    chmod 0755 /usr/local/bin/playwright-browser /usr/local/bin/fetch-page; \
    for name in chromium chromium-browser google-chrome chrome firefox webkit; do \
      ln -sf /usr/local/bin/playwright-browser "/usr/local/bin/${name}"; \
    done; \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g "playwright@${PLAYWRIGHT_VERSION}"; \
    playwright install --with-deps chromium firefox webkit; \
    npm cache clean --force || true; \
    rm -rf /var/lib/apt/lists/*; \
    playwright --version; \
    test -d "$PLAYWRIGHT_BROWSERS_PATH"

### RELEASED FILE TOOL BINARIES ###

ARG CZKAWKA_VERSION=12.0.2
ARG CZKAWKA_SHA256_AMD64=61e7e8ac3f42338957ddc0739df653b9df6ff2958cab3b4cce14663b39c40843
ARG CZKAWKA_SHA256_ARM64=3a65408ca30036cf1cd993112bde6288e13c870842d12131dee8b4e435325c38

ARG RGA_VERSION=0.10.10
ARG RGA_SHA256_AMD64=a969c25b182ac84aa672518313b5f741091decf7d93d03a020bcfe517b9ff4e8
ARG RGA_SHA256_ARM64=2cd875ab6c78b27e4830b5bca92c570a8a8dcfb368bc71b189b65ac01fbc3020

RUN set -e; \
    case "$TARGETARCH" in \
      amd64) czkawka_asset="linux_czkawka_cli_x86_64"; czkawka_sha256="$CZKAWKA_SHA256_AMD64" ;; \
      arm64) czkawka_asset="linux_czkawka_cli_arm64"; czkawka_sha256="$CZKAWKA_SHA256_ARM64" ;; \
      *) echo "Unsupported Czkawka architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/qarmin/czkawka/releases/download/${CZKAWKA_VERSION}/${czkawka_asset}" -o /tmp/czkawka_cli; \
    echo "${czkawka_sha256}  /tmp/czkawka_cli" | sha256sum -c -; \
    install -m 0755 /tmp/czkawka_cli /usr/local/bin/czkawka_cli; \
    ln -sf /usr/local/bin/czkawka_cli /usr/local/bin/czkawka; \
    rm -f /tmp/czkawka_cli; \
    case "$TARGETARCH" in \
      amd64) rga_target="x86_64-unknown-linux-musl"; rga_sha256="$RGA_SHA256_AMD64" ;; \
      arm64) rga_target="aarch64-unknown-linux-gnu"; rga_sha256="$RGA_SHA256_ARM64" ;; \
      *) echo "Unsupported ripgrep-all architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    rga_dir="ripgrep_all-v${RGA_VERSION}-${rga_target}"; \
    curl -fsSL "https://github.com/phiresky/ripgrep-all/releases/download/v${RGA_VERSION}/${rga_dir}.tar.gz" -o /tmp/rga.tar.gz; \
    echo "${rga_sha256}  /tmp/rga.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/rga.tar.gz -C /tmp; \
    install -m 0755 "/tmp/${rga_dir}/rga" /usr/local/bin/rga; \
    install -m 0755 "/tmp/${rga_dir}/rga-preproc" /usr/local/bin/rga-preproc; \
    install -m 0755 "/tmp/${rga_dir}/rga-fzf" /usr/local/bin/rga-fzf; \
    install -m 0755 "/tmp/${rga_dir}/rga-fzf-open" /usr/local/bin/rga-fzf-open; \
    rm -rf /tmp/rga.tar.gz "/tmp/${rga_dir}"; \
    czkawka --version; \
    rga --version

