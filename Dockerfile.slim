### AI CLIS ###

ARG CLAUDE_CODE_VERSION=2.1.289
ARG GEMINI_CLI_VERSION=0.62.0
ARG CODEX_CLI_VERSION=0.164.0
ARG CODEX_PACKAGE_SHA256_AMD64=3ec55053109608d5038f7e50750f7d25f768dfd740fef071aa710e2559b63aac
ARG CODEX_PACKAGE_SHA256_ARM64=5918add6c7e9cf1e14a9af1b4c0f4bf1d24a43903faac26df5dc4c019ea91bd5

ARG ANTIGRAVITY_CLI_VERSION=1.2.16
ARG ANTIGRAVITY_CLI_URL_AMD64=https://github.com/google-antigravity/antigravity-cli/releases/download/1.2.16/agy_cli_linux_x64.tar.gz
ARG ANTIGRAVITY_CLI_SHA256_AMD64=d4247430e04cebdbe1ca93d9ccb483cd2f3daeb4cdb0ace5a71cd130e0bdab84
ARG ANTIGRAVITY_CLI_URL_ARM64=https://github.com/google-antigravity/antigravity-cli/releases/download/1.2.16/agy_cli_linux_arm64.tar.gz
ARG ANTIGRAVITY_CLI_SHA256_ARM64=a6d269d2764e5636ab2bcda73b78c587fe9d00ead767aa3974574229585ee0d3

RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -e; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        g++=4:13.2.* \
        pkg-config=1.8.*; \
    npm install -g --allow-scripts=@anthropic-ai/claude-code,@github/keytar,node-pty \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        "@google/gemini-cli@${GEMINI_CLI_VERSION}"; \
    npm cache clean --force || true; \
    apt-get purge -y --auto-remove g++ pkg-config; \
    rm -rf /var/lib/apt/lists/*; \
    case "$TARGETARCH" in \
      amd64) codex_arch="x86_64"; codex_sha256="$CODEX_PACKAGE_SHA256_AMD64" ;; \
      arm64) codex_arch="aarch64"; codex_sha256="$CODEX_PACKAGE_SHA256_ARM64" ;; \
      *) echo "Unsupported Codex CLI architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    codex_asset="codex-package-${codex_arch}-unknown-linux-musl"; \
    codex_url="https://github.com/openai/codex/releases/download/rust-v${CODEX_CLI_VERSION}/${codex_asset}.tar.gz"; \
    curl -fsSL "$codex_url" -o /tmp/codex.tar.gz; \
    echo "${codex_sha256}  /tmp/codex.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/codex/cli; \
    tar -xzf /tmp/codex.tar.gz -C /opt/codex/cli; \
    ln -s /opt/codex/cli/bin/codex /usr/local/bin/codex; \
    ln -s /opt/codex/cli/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host; \
    rm -f /tmp/codex.tar.gz; \
    case "$TARGETARCH" in \
      amd64) agy_url="$ANTIGRAVITY_CLI_URL_AMD64"; agy_sha256="$ANTIGRAVITY_CLI_SHA256_AMD64" ;; \
      arm64) agy_url="$ANTIGRAVITY_CLI_URL_ARM64"; agy_sha256="$ANTIGRAVITY_CLI_SHA256_ARM64" ;; \
      *) echo "Unsupported Antigravity CLI architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "$agy_url" -o /tmp/antigravity.tar.gz; \
    echo "${agy_sha256}  /tmp/antigravity.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/antigravity.tar.gz -C /tmp antigravity; \
    install -m 0755 /tmp/antigravity /usr/local/bin/agy; \
    ln -sf /usr/local/bin/agy /usr/local/bin/antigravity; \
    rm -f /tmp/antigravity.tar.gz /tmp/antigravity; \
    codex --version; \
    codex-code-mode-host --help >/dev/null; \
    claude --version; \
    gemini --version; \
    test "$(agy --version)" = "$ANTIGRAVITY_CLI_VERSION"

