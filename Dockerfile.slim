### PYTHON CLI HELPERS ###

ARG UV_VERSION=0.12.6
ARG FFSUBSYNC_VERSION=0.5.1

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/pipx \
    python3 -m pip install --break-system-packages --no-cache-dir --no-compile "uv==${UV_VERSION}" \
    && pipx install --pip-args="--no-cache-dir --no-compile --root-user-action=ignore" "ffsubsync==${FFSUBSYNC_VERSION}" \
    && uv --version \
    && ffsubsync --version

### NODE ###

ARG NODE_VERSION=24.20.0
ARG NODE_SHA256_AMD64=2f2c0da162318f0de47665410c7c8c2ed3d36c8f3105de4bbc61176c70a7cbf2
ARG NODE_SHA256_ARM64=5f4ddab610c1ab2016b3c227cebdbf6d9495161487e4739c7b90090595f465f7
ARG NPM_VERSION=12.0.2

RUN --mount=type=cache,target=/root/.npm \
    set -e; \
    case "$TARGETARCH" in \
      amd64) node_arch="x64"; node_sha256="$NODE_SHA256_AMD64" ;; \
      arm64) node_arch="arm64"; node_sha256="$NODE_SHA256_ARM64" ;; \
      *) echo "Unsupported Node.js architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    node_asset="node-v${NODE_VERSION}-linux-${node_arch}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${node_asset}.tar.xz" -o /tmp/node.tar.xz; \
    echo "${node_sha256}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    npm install -g "npm@${NPM_VERSION}"; \
    npm cache clean --force || true; \
    node --version; \
    npm --version

### HEADLESS BROWSERS ###

ARG PLAYWRIGHT_VERSION=1.62.1

COPY playwright-browser fetch-page /usr/local/bin/

RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -e; \
    chmod 0755 /usr/local/bin/playwright-browser /usr/local/bin/fetch-page; \
    for name in chromium chromium-browser google-chrome chrome firefox webkit; do \
      ln -sf /usr/local/bin/playwright-browser "/usr/local/bin/${name}"; \
    done; \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g "playwright@${PLAYWRIGHT_VERSION}"; \
    playwright install --with-deps chromium firefox webkit; \
    npm cache clean --force || true; \
    rm -rf /var/lib/apt/lists/*; \
    playwright --version; \
    test -d "$PLAYWRIGHT_BROWSERS_PATH"

