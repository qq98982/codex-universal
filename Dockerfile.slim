### AI CLIS ###

ARG CLAUDE_CODE_VERSION=2.1.247
ARG GEMINI_CLI_VERSION=0.57.0
ARG CODEX_CLI_VERSION=0.150.1
ARG CODEX_CLI_SHA256_AMD64=ab308870bc7fc048c23dc49d03f6b8af9ce7fc99b9da882d6688be7a90155c7a
ARG CODEX_CLI_SHA256_ARM64=5bb1f75e1a1588845b4a31f2c98fb2b394be5c2a8d90a24a8ab0ebbae1169264
ARG CODEX_CODE_MODE_HOST_SHA256_AMD64=b47667846125cdf6dbc460c6fdc418afb2ef3926c54f4d999bbfbeb08dee4fc5
ARG CODEX_CODE_MODE_HOST_SHA256_ARM64=cc934a8aa36dea77ad3096e025cbe7f2097f0083df902e7f3ed77dbf91fa6f9c

ARG ANTIGRAVITY_CLI_VERSION=1.1.22
ARG ANTIGRAVITY_CLI_URL_AMD64=https://github.com/google-antigravity/antigravity-cli/releases/download/1.1.22/agy_cli_linux_x64.tar.gz
ARG ANTIGRAVITY_CLI_SHA256_AMD64=1e1a219a86e75d7c6351f96d182ca2105302d5c34d8fa9c31265dc0adf24145f
ARG ANTIGRAVITY_CLI_URL_ARM64=https://github.com/google-antigravity/antigravity-cli/releases/download/1.1.22/agy_cli_linux_arm64.tar.gz
ARG ANTIGRAVITY_CLI_SHA256_ARM64=a68925bc7336eb0b90de1e1aefd44d535f5487b7cf606a76fdb982207aef9a2e

RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -e; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        g++=4:13.2.* \
        pkg-config=1.8.*; \
    npm install -g --allow-scripts=@anthropic-ai/claude-code,@github/keytar,node-pty \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        "@google/gemini-cli@${GEMINI_CLI_VERSION}"; \
    npm cache clean --force || true; \
    apt-get purge -y --auto-remove g++ pkg-config; \
    rm -rf /var/lib/apt/lists/*; \
    case "$TARGETARCH" in \
      amd64) codex_arch="x86_64"; codex_sha256="$CODEX_CLI_SHA256_AMD64"; codex_code_mode_host_sha256="$CODEX_CODE_MODE_HOST_SHA256_AMD64" ;; \
      arm64) codex_arch="aarch64"; codex_sha256="$CODEX_CLI_SHA256_ARM64"; codex_code_mode_host_sha256="$CODEX_CODE_MODE_HOST_SHA256_ARM64" ;; \
      *) echo "Unsupported Codex CLI architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    codex_asset="codex-${codex_arch}-unknown-linux-musl"; \
    codex_url="https://github.com/openai/codex/releases/download/rust-v${CODEX_CLI_VERSION}/${codex_asset}.tar.gz"; \
    curl -fsSL "$codex_url" -o /tmp/codex.tar.gz; \
    echo "${codex_sha256}  /tmp/codex.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/codex.tar.gz -C /tmp; \
    install -m 0755 "/tmp/${codex_asset}" /usr/local/bin/codex; \
    rm -f /tmp/codex.tar.gz "/tmp/${codex_asset}"; \
    codex_code_mode_host_asset="codex-code-mode-host-${codex_arch}-unknown-linux-musl"; \
    codex_code_mode_host_url="https://github.com/openai/codex/releases/download/rust-v${CODEX_CLI_VERSION}/${codex_code_mode_host_asset}.tar.gz"; \
    curl -fsSL "$codex_code_mode_host_url" -o /tmp/codex-code-mode-host.tar.gz; \
    echo "${codex_code_mode_host_sha256}  /tmp/codex-code-mode-host.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/codex-code-mode-host.tar.gz -C /tmp; \
    install -m 0755 "/tmp/${codex_code_mode_host_asset}" /usr/local/bin/codex-code-mode-host; \
    rm -f /tmp/codex-code-mode-host.tar.gz "/tmp/${codex_code_mode_host_asset}"; \
    case "$TARGETARCH" in \
      amd64) agy_url="$ANTIGRAVITY_CLI_URL_AMD64"; agy_sha256="$ANTIGRAVITY_CLI_SHA256_AMD64" ;; \
      arm64) agy_url="$ANTIGRAVITY_CLI_URL_ARM64"; agy_sha256="$ANTIGRAVITY_CLI_SHA256_ARM64" ;; \
      *) echo "Unsupported Antigravity CLI architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "$agy_url" -o /tmp/antigravity.tar.gz; \
    echo "${agy_sha256}  /tmp/antigravity.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/antigravity.tar.gz -C /tmp antigravity; \
    install -m 0755 /tmp/antigravity /usr/local/bin/agy; \
    ln -sf /usr/local/bin/agy /usr/local/bin/antigravity; \
    rm -f /tmp/antigravity.tar.gz /tmp/antigravity; \
    codex --version; \
    codex-code-mode-host --help >/dev/null; \
    claude --version; \
    gemini --version; \
    test "$(agy --version)" = "$ANTIGRAVITY_CLI_VERSION"

